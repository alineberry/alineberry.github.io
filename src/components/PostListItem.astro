---
interface Props {
  title: string;
  href: string;
  date: Date;
  description?: string;
  tags?: string[];
  minutes?: number;
}
const { title, href, date, description, tags = [], minutes } = Astro.props;
const dateStr = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
---

<li>
  <a class="title-link" href={href}>
    <div class="post-row">
      <time class="when" datetime={date.toISOString()}>{dateStr}</time>
      <div>
        <div class="title">{title}</div>
        {description && <div class="desc">{description}</div>}
        <div class="meta">
          {minutes && <span>{minutes} min</span>}
          {tags.length > 0 && (
            <>
              <span class="dot">·</span>
              <span>{tags.join(', ')}</span>
            </>
          )}
        </div>
      </div>
    </div>
  </a>
</li>
